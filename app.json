{
  "expo": {
    "name": "Corte Fino",
    "slug": "barbershop",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#110704"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cortefino.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#110704"
      },
      "package": "com.cortefino.app",
      "versionCode": 2
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5cf902bd-04eb-49aa-88a1-f4bae014ef43"
      }
    },
    "owner": "jhonatan_a1ves"
  }
}
